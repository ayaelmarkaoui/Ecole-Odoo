<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
account.report_invoice_with_payments
        <!-- Héritage de la vue de formulaire pour account.move -->
        <record id="view_move_form_inherit" model="ir.ui.view">
            <field name="name">account.move.form.inherit.description</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <!-- Ajouter un champ description après le champ product_id -->
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="description" string="Description" placeholder="Add a description"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
